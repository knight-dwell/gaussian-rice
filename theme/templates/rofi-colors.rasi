/* GENERATED by ~/.config/theme/scripts/apply-theme.sh (colors: {{color_source}}) */
* {
  th-bg:          {{surface_container}};
  th-bg-alt:      {{surface_container_high}};
  th-bg-input:    {{surface_container_highest}};
  th-selected:    {{primary_container}};
  th-on-selected: {{on_primary_container}};
  th-fg:          {{on_surface}};
  th-fg-alt:      {{on_surface_variant}};
  th-accent:      {{primary}};
  th-outline:     {{outline_variant}};
  th-urgent:      {{error}};
  th-font:        "{{font_family}} {{font_size}}";
  th-radius:      {{radius}}px;
  th-space-sm:    {{space_sm}}px;
  th-space-md:    {{space_md}}px;
  th-space-lg:    {{space_lg}}px;
}
