#version 330
// GENERATED by ~/.config/theme/scripts/apply-theme.sh
// picom window shader: paints the outer {{border_width}}px of the window (i3's
// border) in the terminal color. Used for unfocused (dimmed) kitty windows.
in vec2 texcoord;
uniform sampler2D tex;
vec4 default_post_processing(vec4 c);

const vec3 BORDER = {{border_terminal|mix:surface:0.45|vec3}};
const float W = {{border_width}}.0;

vec4 window_shader() {
    vec2 size = vec2(textureSize(tex, 0));
    vec4 c = texelFetch(tex, ivec2(texcoord), 0);
    if (texcoord.x < W || texcoord.y < W || texcoord.x >= size.x - W || texcoord.y >= size.y - W)
        c = vec4(BORDER, 1.0);
    return default_post_processing(c);
}
