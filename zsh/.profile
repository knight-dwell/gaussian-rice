# ~/.profile: sourced by the X session (/etc/X11/xinit/xinitrc-common, via
# LightDM) before i3 starts. Created by the i3 rice; safe to extend.
# zsh does not read this file, so your shell config is unaffected.

# Qt apps use qt5ct/qt6ct (theme colors from ~/.config/theme)
export QT_QPA_PLATFORMTHEME=qt5ct
# cursor for apps that don't read GTK settings
export XCURSOR_THEME=Bibata-Modern-Classic
export XCURSOR_SIZE=24
