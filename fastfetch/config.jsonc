// ~/.config/fastfetch/config.jsonc: compact, themed startup info for new terminals.
// Logo: bat signal (~/.config/terminal-greeter/art). Colors are ANSI names ("blue", "red", ...), so they follow the terminal palette
// that ~/.config/theme generates. Edit with Terminal Studio or by hand.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/terminal-greeter/art/batsignal.txt",
    "color": { "1": "yellow", "2": "blue" },
    "padding": { "top": 0, "left": 1, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "blue", "title": "red" },
    "key": { "width": 12 },
    "bar": { "char": { "elapsed": "━", "total": "─" }, "width": 12 },
    "percent": { "type": 3, "color": { "green": "blue", "yellow": "yellow", "red": "red" } }
  },
  "modules": [
    { "type": "custom", "format": "\u001b[1;33m🦇 Welcome, \u001b[1;34mgaussian_knight" },  // name: edit in Terminal Studio
    { "type": "custom", "format": "\u001b[90m─────────────────────────────" },
    { "type": "os",       "key": "\uf30a os",     "format": "{pretty-name}" },
    { "type": "kernel",   "key": "\uf17c kernel" , "format": "{release}" },
    { "type": "wm",       "key": "\uf2d2 wm",     "format": "{pretty-name}" },
    { "type": "command",  "key": "\uf489 shell",  "text": "zsh --version | cut -d\" \" -f1,2" },  // real shell (fastfetch's parent is the greeter)
    { "type": "uptime",   "key": "󰅐 uptime" },
    { "type": "cpu",      "key": "\uf4bc cpu",    "format": "{name} ({cores-logical})", "temp": false },
    { "type": "memory",   "key": "\uefc5 ram", "format": "{percentage-bar} {used} / {total}" },
    { "type": "disk",     "key": "󰋊 disk", "folders": "/", "format": "{size-percentage-bar} {size-used} / {size-total}" },
    { "type": "battery",  "key": "󰁹 battery", "format": "{capacity} {status}" },
    { "type": "custom", "format": "\u001b[90m─────────────────────────────" },
    { "type": "colors", "symbol": "circle", "paddingLeft": 0 }
  ]
}
